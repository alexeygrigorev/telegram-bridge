# Configuration checklist only; load via your service's environment mechanism.
DATAOPS_TELEGRAM_BOT_TOKEN=
# Required in production: HTTPS dead-man with failure recipient dev@ / on-call.
# Never route system failures to Alexey's personal email, chat or channels.
OPERATOR_COMMS_HEARTBEAT_URL=
OPERATOR_COMMS_HEARTBEAT_TOKEN=
# Optional explicit operator chat. Empty means logs + external dead-man only.
# No personal-chat default or fallback; the known personal chat is rejected.
DATAOPS_TELEGRAM_ALERT_CHAT=
